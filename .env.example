# Copy to .env and adjust if needed. All values below are the defaults
# already baked into docker-compose.yml, so having no .env at all also works.
# These are local-dev-only credentials — never use them anywhere else.

# --- PostgreSQL ---
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDISINSIGHT_PORT=5540

# --- MongoDB ---
MONGO_ROOT_USERNAME=devuser
MONGO_ROOT_PASSWORD=devpassword
MONGO_PORT=27017
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=devpassword
MONGO_EXPRESS_PORT=8081

# --- Keycloak ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8084

# --- EventStoreDB ---
EVENTSTOREDB_PORT=2113

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# --- Observability (OpenTelemetry / Jaeger / Prometheus) ---
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
